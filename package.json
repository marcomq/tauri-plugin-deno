{
  "name": "tauri-plugin-deno-api",
  "version": "0.4.0",
  "author": "Marco Mengelkoch",
  "description": "Javascript package for tauri plugin deno.",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs",
    "html": "./dist-js/index.iife.js"
  },
  "bin": {
    "tauri-plugin-deno-api": "guest-js/deno_bundler.js"
  },
  "files": [
    "dist-js",
    "guest-js/deno_bundler.js",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "deno test -A --no-check guest-js/",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcomq/tauri-plugin-deno.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/marcomq/tauri-plugin-deno#readme",
  "bugs": {
    "url": "https://github.com/marcomq/tauri-plugin-deno/issues"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.50.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
